[Unit]
Description=Authrim Wordwarden Directory Connector
Documentation=https://github.com/authrim/authrim-wordwarden
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wordwarden
Group=wordwarden
ExecStart=/usr/local/bin/wordwarden --config /etc/authrim-wordwarden/config.yaml serve
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/authrim-wordwarden
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
